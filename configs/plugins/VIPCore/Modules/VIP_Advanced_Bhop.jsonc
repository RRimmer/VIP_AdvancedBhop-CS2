{
  // Версия формата конфигурации.
  "ConfigVersion": 1,
  // Предел горизонтальной скорости при удержании прыжка, единиц/с.
  // 0 (по умолчанию) — фиксированный потолок 300 единиц/с.
  // -1 — только ограничения движка, без дополнительного ограничения скорости плагином.
  "bhop_max_speed": 0,
  // Через сколько секунд скрыть HUD при бессрочной активности или блокировке (включая пистолетный раунд). 0 — показывать постоянно.
  "bhop_hud_autohide_seconds": 5,
  // Формат Panorama: 1 — только тост, 2 — только отсчёт, 3 — оба.
  "bhop_display_mode": 3,
  // Позиция: 0 — под радаром, 1 — под счётом, 2 — под прицелом, 3 — над HP.
  "bhop_hud_position": 0,
  // Разрешить выбор в !vip. Добавьте "BhopHud": 1 в нужные группы vip.json.
  "bhop_player_display_settings": false,
  // Канал уведомлений: 0 — выкл., 1 — чат, 2 — Panorama, 3 — оба.
  "bhop_info": 2,
  // Получатели: 0 — все, 1 — только VIP с доступом.
  "bhop_notify": 0,
  // Сколько секунд доступа к Bhop. 0 — до конца раунда.
  "bhop_allowtime": 5,
  // Кулдаун в секундах для групп со значением Bhop = 1.
  "bhop_locktime": 15,
  // Блокировать после урона противника: 0 — нет, 1 — да.
  "bhop_restrict_type": 0,
  // Длительность блокировки после попадания, секунды.
  "bhop_restrict_time": 2,
  // Дополнительный запрет на пистолетных раундах: 0 — нет, 1 — да.
  "bhop_first_round_off": 0,
  // Интервал аудита клиентских значений, секунды; 0 — отключить.
  "bhop_stability_audit_interval": 0.25,
  // Восстанавливать реплику при читаемом расхождении: 0 — нет, 1 — да.
  "bhop_stability_audit_force": 1
}

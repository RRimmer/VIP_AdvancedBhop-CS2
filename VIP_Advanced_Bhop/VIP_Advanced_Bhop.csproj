<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VipApiDll Condition="'$(VipApiDll)' == ''">../lib/VipCoreApi/VipCoreApi.dll</VipApiDll>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="[1.0.380]" ExcludeAssets="runtime" />
    <Reference Include="VipCoreApi" HintPath="$(VipApiDll)" Private="false" />
    <EmbeddedResource Include="../configs/plugins/VIPCore/Modules/VIP_Advanced_Bhop.jsonc" LogicalName="BhopDefaults" />
    <None Update="lang/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
